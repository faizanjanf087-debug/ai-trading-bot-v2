# Asli keys yahan MAT likhein. Replit mein Tools -> Secrets use karein.
TELEGRAM_BOT_TOKEN=
OWNER_ID=
TWELVEDATA_API_KEY=
DEEPSEEK_API_KEY=

# Optional (defaults theek hain)
# DEEPSEEK_MODEL=deepseek-chat
# WATCHLIST=XAUUSD,EURUSD,GBPUSD,USDJPY,BTCUSD,ETHUSD,SOLUSD
# ENABLE_SCANNER=true
# FOREX_MODES=scalp
# CRYPTO_MODES=scalp,intraday
# FOREX_SCAN_MINUTES=10
# CRYPTO_SCAN_MINUTES=5
# SESSION_UTC=07-20
# MIN_SCORE=6
# AI_VETO=false
# DATABASE_PATH=data/bot.db

# Supabase (Postgres) database. Ye set ho to bot SQLite ki jagah Supabase use karta hai (khali ho to SQLite).
# Supabase -> Connect -> "Session pooler" wali string yahan se copy karein, [YOUR-PASSWORD] ki jagah asli password.
# Password mein khaas nishan (@ : / # ?) hon to unhe URL-encode karein.
# Asli string sirf Replit Secrets mein rakhein, is file mein ya GitHub par kabhi nahi.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# V2.2 news / calendar
# ENABLE_CALENDAR=true
# CALENDAR_URL=            # khali = default free weekly feed; apna JSON feed (title,country,date,impact) bhi de sakte hain
# NEWS_BLACKOUT_BEFORE_MIN=30
# NEWS_BLACKOUT_AFTER_MIN=15

# V2.3 discipline (sirf yaad-dehani)
# LOSS_STREAK_WARN=3
# DAILY_LOSS_LIMIT_R=3
# MAX_SIGNALS_PER_DAY=6

# V2.4 voice aur image (key khali = feature band)
# Voice (speech-to-text): Groq (free tier) ya koi OpenAI-compatible service
# STT_API_KEY=             # ya GROQ_API_KEY
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# VOICE_MAX_SECONDS=60
# Chart image parhna (Claude vision)
# ANTHROPIC_API_KEY=
# VISION_MODEL=claude-haiku-5-5
# MEDIA_DAILY_LIMIT=20     # har user ki roz ki voice+image hadd
